<Window x:Class="VoiceRocorder.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="VoiceRocorder" Height="760" Width="1080" MinHeight="650" MinWidth="820"
 WindowStartupLocation="CenterScreen" Background="#15181E" Foreground="#F5F7FA">
 <Grid Margin="26">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Grid Grid.Row="0" Margin="0,0,0,22">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="VoiceRocorder" FontSize="29" FontWeight="SemiBold"/>
    <TextBlock Text="Запись голоса · отдельные дорожки · реверс" Foreground="#9AA4B2" FontSize="13" Margin="1,5,0,0"/>
   </StackPanel>
   <Border Grid.Column="1" Background="#222833" CornerRadius="18" Padding="13,7" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal">
     <Ellipse Width="8" Height="8" Fill="#54D38A" Margin="0,0,8,0"/>
     <TextBlock Text="Локальная запись" Foreground="#C9D2DE" FontSize="12"/>
    </StackPanel>
   </Border>
  </Grid>

  <Border Grid.Row="1" Background="#20252E" CornerRadius="14" Padding="16" Margin="0,0,0,14">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
     <TextBlock Text="ИСТОЧНИК ЗВУКА" FontSize="10" Foreground="#9AA4B2" FontWeight="Bold"/>
     <TextBlock Text="Микрофон" FontSize="14" Margin="0,4,0,0"/>
    </StackPanel>
    <ComboBox x:Name="MicrophoneBox" Grid.Column="1" DisplayMemberPath="Name" VerticalAlignment="Center"/>
    <Button Grid.Column="2" Content="⟳  Обновить" Click="Refresh_Click" VerticalAlignment="Center"/>
   </Grid>
  </Border>

  <Border Grid.Row="2" Background="#20252E" CornerRadius="14" Padding="18" Margin="0,0,0,14">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
     <TextBlock Text="ЗАПИСЬ" FontSize="10" Foreground="#9AA4B2" FontWeight="Bold"/>
     <TextBlock x:Name="TimerText" Text="00:00" FontSize="28" FontWeight="Light" Margin="0,3,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock x:Name="StatusText" Text="Готово к записи" Foreground="#C7D0DC" FontSize="13"/>
     <TextBlock Text="Нажми запись, чтобы создать новую дорожку" Foreground="#7F8997" FontSize="11" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="RecordButton" Content="●  Запись" Background="#D94B55" BorderBrush="#D94B55" FontWeight="SemiBold" MinWidth="116" Click="Record_Click"/>
     <Button x:Name="StopButton" Content="■  Стоп" MinWidth="90" IsEnabled="False" Click="Stop_Click"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="3">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Margin="2,0,2,10">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="Мои записи" FontSize="19" FontWeight="SemiBold"/>
     <TextBlock x:Name="TrackCountText" Text="Пока нет дорожек" Foreground="#929CAB" FontSize="12" Margin="0,4,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="▶  Оригинал" Click="PlayOriginal_Click"/>
     <Button Content="◀  Реверс" Click="PlayReverse_Click"/>
     <Button Content="■" ToolTip="Остановить воспроизведение" Click="StopPlayback_Click" MinWidth="42"/>
    </StackPanel>
   </Grid>
   <Border Grid.Row="1" Background="#20252E" CornerRadius="14" Padding="12">
    <Grid>
     <ListBox x:Name="TracksList" SelectionChanged="TracksList_SelectionChanged">
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Border Background="#2A303B" CornerRadius="10" Padding="14" Margin="3">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="17" Background="#384B6C" VerticalAlignment="Center">
           <TextBlock Text="♫" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
           <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
           <TextBlock Text="{Binding Mode}" Foreground="#9AA4B2" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#9AA4B2" VerticalAlignment="Center" Margin="12,0"/>
         </Grid>
        </Border>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
  </Grid>

  <Border Grid.Row="4" Background="#20252E" CornerRadius="12" Padding="10,7" Margin="0,14,0,0">
   <DockPanel>
    <TextBlock x:Name="FooterStatusText" Text="Готово" Foreground="#9AA4B2" FontSize="11" VerticalAlignment="Center"/>
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
     <Button Content="Перевернуть" Click="Reverse_Click"/>
     <Button Content="Оригинал" Click="Original_Click"/>
     <Button Content="Экспорт WAV" Click="Export_Click"/>
     <Button Content="Сохранить проект" Click="SaveProject_Click"/>
     <Button Content="Открыть проект" Click="OpenProject_Click"/>
    </StackPanel>
   </DockPanel>
  </Border>
 </Grid>
</Window>
