<Window x:Class="VoiceRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Recorder" Height="680" Width="980"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Вход:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="InputDeviceBox" Width="230" Height="28"
                          SelectionChanged="InputDeviceBox_SelectionChanged"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Voice Recorder" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="Записывай голоса, переворачивай и сохраняй каждый отдельно."
                           Foreground="Gray" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Padding="12" CornerRadius="8"
                BorderBrush="#D5D9DE" BorderThickness="1" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="RecordButton" Content="● Запись" Click="RecordButton_Click"
                            Background="#C62828" Foreground="White" FontWeight="SemiBold"/>
                    <Button x:Name="StopButton" Content="■ Стоп" Click="StopButton_Click" IsEnabled="False"/>
                    <Button Content="+ Новая запись" Click="NewRecording_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="Готово к записи"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="4,0,4,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Записи" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Оригинал сохраняется при реверсе"
                           Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Действия" Foreground="Gray"
                           VerticalAlignment="Center"/>
            </Grid>
            <ListBox x:Name="TracksList" Grid.Row="1" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#D5D9DE" BorderThickness="1" CornerRadius="7"
                                Padding="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Details}" Foreground="Gray" FontSize="12" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding ReverseStatus}" Foreground="#287A46" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <Button Content="▶ Оригинал" Tag="{Binding}" Click="PlayOriginal_Click"/>
                                    <Button Content="▶ Реверс" Tag="{Binding}" Click="PlayReverse_Click"
                                            IsEnabled="{Binding HasReverse}"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="Обратить" Tag="{Binding}" Click="Reverse_Click"/>
                                    <Button Content="Экспорт" Tag="{Binding}" Click="Export_Click"/>
                                    <Button Content="Удалить" Tag="{Binding}" Click="Delete_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="FolderText" Foreground="Gray"
                   TextWrapping="Wrap" Margin="2,12,2,0"/>
    </Grid>
</Window>
